# Current generated study outputs are local by default, regardless of size.
# The separate Git blob guard blocks files >50 MB even when force-added.
# To publish a smaller selected output, review it first and use git add -f.
/eye_tracking_foundations/output/*
!/eye_tracking_foundations/output/.gitkeep

# Study 2 machine-learning artefacts and results are local by default.
/eye_movement_modelling/output/*
!/eye_movement_modelling/output/.gitkeep
